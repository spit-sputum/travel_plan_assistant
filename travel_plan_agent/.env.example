# 复制本文件为 .env 并填写。

# ==================== 大模型（可切换任意 OpenAI 兼容服务） ====================
# 供应商：qwen / deepseek / openai / moonshot / zhipu / custom
MODEL_PROVIDER=qwen
# 模型名：留空则使用该供应商默认模型
MODEL_NAME=
# 接口地址：留空则使用该供应商默认地址；自建/专属网关必须填写
MODEL_API_URL=
# 接口密钥
MODEL_API_KEY=
# 采样温度
MODEL_TEMPERATURE=0.75
# 是否开启思考模式
ENABLE_THINKING=false

# ==================== 工具类 API ====================
# 攻略 / 景点 / 餐厅 / 酒店 检索
TAVILY_API_KEY=
# 高德地图：路线规划
GAODE_KEY=
# 和风天气：天气预报
HEFENG_KEY=
HEFENG_HOST=
